# 테스트 대상
BASE_URL=http://host.docker.internal:8080

# 인증: ACCESS_TOKEN이 있으면 로그인 계정보다 우선 사용합니다.
TEST_LOGIN_ID=
TEST_PASSWORD=
ACCESS_TOKEN=
AUTH_REQUIRED=true

# 실행 프로필: smoke | load | stress
PROFILE=smoke
TEST_ID=

# 안전장치
ALLOW_INSECURE_LOCAL_AUTH=false
ALLOW_REMOTE=false
ALLOW_WRITE=false
ALLOW_STRESS=false

# 범용 인증 조회 시나리오
ENDPOINT_PATH=/api/rewards/points
ENDPOINT_NAME=point-balance
DOMAIN=point
THINK_TIME_SECONDS=1

# 공통 Threshold
MAX_P95_MS=500
MAX_P99_MS=1000
MAX_ERROR_RATE=0.01

# 프로필별 부하
SMOKE_VUS=1
SMOKE_ITERATIONS=1
LOAD_MAX_VUS=20
STRESS_MAX_VUS=50

# 리워드 멱등성 동시 구매 시나리오
REWARD_CONCURRENCY=10
REWARD_PRODUCT_ID=
REWARD_RECEIVER_NAME=
REWARD_RECEIVER_PHONE=

# Prometheus Remote Write
K6_OUTPUT=local
K6_PROMETHEUS_RW_SERVER_URL=http://host.docker.internal:9090/api/v1/write
K6_PROMETHEUS_RW_TREND_STATS=p(95),p(99),min,max,avg
K6_PROMETHEUS_RW_STALE_MARKERS=true
