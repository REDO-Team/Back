logging {
  level  = "info"
  format = "logfmt"
}

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "container_logs" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "service_name"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  labels        = {
    environment = "production",
    host        = "service-ec2",
    platform    = "docker",
  }
  relabel_rules = discovery.relabel.container_logs.rules
  forward_to    = [loki.write.monitoring.receiver]
}

loki.write "monitoring" {
  endpoint {
    url       = "http://" + sys.env("MONITORING_PRIVATE_IP") + ":3100/loki/api/v1/push"
    tenant_id = sys.env("LOKI_TENANT_ID")
  }
}
